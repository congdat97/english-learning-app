{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/*.{css,js,ico,png,jpg,jpeg,gif,svg,webp,woff,woff2,json}"]
  },
  "globalHeaders": {
    "Cache-Control": "no-cache, no-store, must-revalidate"
  },
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "name": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "name": "Content-Type",
          "value": "text/html; charset=utf-8"
        }
      ]
    }
  ],
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 200
    }
  }
}
